# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# --- storage -----------------------------------------------------------
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
# Used when running the app on the host (outside compose):
DATABASE_URL=postgresql+psycopg://lexuz:change-me@127.0.0.1:5432/lexuz
REDIS_URL=redis://127.0.0.1:6379/0

# --- AI providers ------------------------------------------------------
# Generation (Anthropic Claude). Leave empty to run ingestion/retrieval only.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_S=60
LLM_REFUSAL_FALLBACK=default
# Prices are only used for ESTIMATED cost / budget accounting. Check current provider pricing.
LLM_INPUT_PRICE_PER_MTOK_USD=4.0
LLM_OUTPUT_PRICE_PER_MTOK_USD=20.0

# Embeddings (local ONNX model via fastembed; downloaded to MODEL_CACHE_DIR on first use)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOCUMENT_PREFIX="passage: "

# --- retrieval ---------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_LIMIT=40
CONTEXT_MAX_TOKENS=6000
MAX_QUESTION_CHARS=600

# --- public demo limits -----------------------------------------------
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=40
MAX_CONCURRENT_LLM_CALLS=4
DAILY_AI_BUDGET_USD=3.0
DAILY_INGESTION_BUDGET_USD=1.0

# --- HTTP -------------------------------------------------------------
# JSON list. Empty = no cross-origin access (frontend is same-origin).
CORS_ORIGINS=[]
ENABLE_API_DOCS=true
# If set, /internal/metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=
# uvicorn trusts X-Forwarded-For only from these addresses (compose: nginx container network).
FORWARDED_ALLOW_IPS=127.0.0.1
