# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# --- storage -----------------------------------------------------------
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
# Used when running the app on the host (outside compose):
DATABASE_URL=postgresql+psycopg://lexuz:change-me@127.0.0.1:5432/lexuz
REDIS_URL=redis://127.0.0.1:6379/0

# --- AI providers ------------------------------------------------------
# Generation: Google Gemini API, FREE TIER ONLY (do not enable billing on the
# Google Cloud project of this key). Put the real key only in your local .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash-lite
LLM_THINKING_LEVEL=minimal
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# Paid-tier list price of gemini-3.5-flash-lite. Free tier is not charged; these
# give a conservative "paid-equivalent" estimate for the budget cap.
LLM_INPUT_PRICE_PER_MTOK_USD=0.30
LLM_OUTPUT_PRICE_PER_MTOK_USD=2.50
# Project-wide caps: set at or below the free-tier limits AI Studio shows for your project.
LLM_GLOBAL_CALLS_PER_MINUTE=5
LLM_GLOBAL_CALLS_PER_DAY=200

# Embeddings (local ONNX model via fastembed; downloaded to MODEL_CACHE_DIR on first use)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOCUMENT_PREFIX="passage: "

# --- retrieval ---------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_RRF_K=10
# Optional local cross-encoder (off). Measured on dev: +0.006 MRR at ~110x latency (D22).
RETRIEVAL_RERANKER=
RETRIEVAL_RERANK_POOL=20
RETRIEVAL_CANDIDATE_LIMIT=40
CONTEXT_MAX_TOKENS=6000
MAX_QUESTION_CHARS=600

# --- public demo limits -----------------------------------------------
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY=20
MAX_CONCURRENT_LLM_CALLS=1
DAILY_AI_BUDGET_USD=3.0
DAILY_INGESTION_BUDGET_USD=1.0

# --- HTTP -------------------------------------------------------------
# JSON list. Empty = no cross-origin access (frontend is same-origin).
CORS_ORIGINS=[]
ENABLE_API_DOCS=true
# If set, /internal/metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=
# uvicorn trusts X-Forwarded-For only from these addresses (compose: nginx container network).
FORWARDED_ALLOW_IPS=127.0.0.1
